{
  "name": "la-casa-de-las-flores-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.js",
    "build": "node scripts/build-public.js",
    "start": "node server.js",
    "prestart": "node scripts/build-styles.js",
    "precheck": "node scripts/build-styles.js",
    "pretest:ui": "node scripts/build-styles.js",
    "check": "node scripts/check-source.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/test-ui.js",
    "images:catalog": "node scripts/process-catalog-images.js && node scripts/optimize-seed-images.js",
    "images:premium": "node scripts/build-premium-catalog-images.js",
    "admin:setup": "node scripts/setup-admin.js",
    "deploy:check": "node scripts/check-deployment.js",
    "audit:live": "node scripts/audit-live.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide": "^1.47.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
