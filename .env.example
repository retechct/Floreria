PORT=3000
# Usa HTTPS y tu dominio definitivo en produccion.
SITE_URL=http://localhost:3000
# Genera estas credenciales con npm run admin:setup (archivo privado .env.admin).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lacasadelasfloresatelier.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# PostgreSQL persistente, obligatorio en Vercel.
DATABASE_URL=
# Alternativa para un solo proceso Node con volumen persistente. No usar en Vercel.
DATA_DIR=

# Ambas llaves deben ser del mismo comercio y entorno: test o live.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Secreto aleatorio de al menos 32 caracteres para la URL privada del webhook.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CULQI_WEBHOOK_SECRET=

# Datos publicos del proveedor para politicas y Libro de Reclamaciones.
BUSINESS_COMMERCIAL_NAME=La Casa de las Flores Atelier
BUSINESS_LEGAL_NAME=tu_razon_social
BUSINESS_RUC=tu_ruc
BUSINESS_ADDRESS=tu_domicilio_fiscal
BUSINESS_EMAIL=ventas@tudominio.com
BUSINESS_CLAIMS_EMAIL=reclamos@tudominio.com
BUSINESS_PHONE=51947370668
