{
  "version": 2,
  "builds": [
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/products.json",
          "lib/**",
          "views/**",
          "config/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/(.*\\.(?:html|css|js))",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/admin.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(?:|admin|[a-z0-9-]+\\.html|robots\\.txt|sitemap\\.xml)",
      "dest": "/server.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
